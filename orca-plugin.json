{
  "$schema": "https://raw.githubusercontent.com/stablyai/orca/main/docs/schemas/plugins/orca-plugin.v2.schema.json",
  "manifestVersion": 2,
  "execution": "trusted-worker",
  "id": "speak-reply",
  "name": "Speak Reply",
  "version": "0.2.0",
  "description": "A status bar button that reads the focused workspace's last agent reply aloud, in chat tabs and terminals. macOS only.",
  "author": { "name": "Fullchee Zhang", "url": "https://github.com/Fullchee" },
  "repository": "https://github.com/Fullchee/orca-speak-reply",
  "license": "MIT",
  "engines": { "orca": ">=1.4.248" },
  "main": "src/worker.ts",
  "capabilities": [{ "kind": "workspace:read" }],
  "contributes": {
    "commands": [{ "id": "speak-reply.toggle", "title": "Read last reply aloud" }],
    "keybindings": [{ "command": "speak-reply.toggle", "key": "Mod+Shift+R" }],
    "statusBarItems": [
      {
        "id": "speak",
        "text": "Read reply",
        "icon": "play",
        "tooltip": "Read the last agent reply in this workspace aloud",
        "command": "speak-reply.toggle"
      }
    ]
  }
}
