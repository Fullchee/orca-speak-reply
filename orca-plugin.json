{
  "$schema": "https://raw.githubusercontent.com/stablyai/orca/main/docs/schemas/plugins/orca-plugin.v2.schema.json",
  "manifestVersion": 2,
  "execution": "trusted-worker",
  "id": "speak-reply",
  "name": "Speak Reply",
  "version": "0.4.0",
  "description": "A status bar button that reads the focused workspace's last agent reply aloud, in chat tabs and terminals. macOS only.",
  "author": { "name": "Fullchee Zhang", "url": "https://github.com/Fullchee" },
  "repository": "https://github.com/Fullchee/orca-speak-reply",
  "license": "MIT",
  "engines": { "orca": ">=1.4.248" },
  "main": "src/worker.ts",
  "capabilities": [{ "kind": "workspace:read" }],
  "contributes": {
    "commands": [
      { "id": "speak-reply.toggle", "title": "Read last reply aloud, or pause and resume it" },
      { "id": "speak-reply.stop", "title": "Stop reading the reply" },
      { "id": "speak-reply.next", "title": "Skip to the next paragraph of the reply" },
      { "id": "speak-reply.previous", "title": "Go back to the previous paragraph of the reply" }
    ],
    "keybindings": [
      { "command": "speak-reply.toggle", "key": "Mod+Shift+R" },
      { "command": "speak-reply.previous", "key": "Mod+Shift+Comma" },
      { "command": "speak-reply.next", "key": "Mod+Shift+Period" }
    ],
    "statusBarItems": [
      {
        "id": "speak",
        "text": "Read reply",
        "icon": "play",
        "tooltip": "Read the last agent reply in this workspace aloud",
        "command": "speak-reply.toggle"
      },
      {
        "id": "previous",
        "text": "Back",
        "tooltip": "Go back to the previous paragraph (⌘⇧,)",
        "command": "speak-reply.previous"
      },
      {
        "id": "next",
        "text": "Next",
        "icon": "next",
        "tooltip": "Skip to the next paragraph (⌘⇧.)",
        "command": "speak-reply.next"
      },
      {
        "id": "stop",
        "text": "Stop",
        "icon": "stop",
        "tooltip": "Stop reading and start from the top next time",
        "command": "speak-reply.stop"
      }
    ]
  }
}
